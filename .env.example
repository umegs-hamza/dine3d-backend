SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
# In production (e.g. the CapRover backend app), set DEBUG=False and include
# the backend's real domain here, for example:
#   ALLOWED_HOSTS=backend.dine3d.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev default (falls back to sqlite:///<project>/db.sqlite3 if unset).
# In production (e.g. the CapRover backend app), set this to your real
# Postgres connection string instead, for example:
#   DATABASE_URL=postgres://user:password@srv-captain--dine3d-db:5432/dine3d
DATABASE_URL=sqlite:///db.sqlite3

# Local dev origins for the three frontends. In production, replace with the
# actual deployed origins instead, for example:
#   CORS_ALLOWED_ORIGINS=https://admin.dine3d.com,https://dine3d.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# Required for any POST/PUT/PATCH/DELETE against this backend's own domain —
# including logging into /admin/ — not just API calls from other origins
# (that's what CORS_ALLOWED_ORIGINS above is for). Empty is fine for local
# dev (same-origin http://127.0.0.1:8000 doesn't need it). In production, set
# this to the backend's own public URL, for example:
#   CSRF_TRUSTED_ORIGINS=https://backend.dine3d.com
CSRF_TRUSTED_ORIGINS=

MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_3D_MODEL_UPLOAD_SIZE_MB=50

# Google Cloud Storage (GCS) bucket for media (images + 3D model files).
# Leave USE_GCS=False to keep serving media from local disk in development.
USE_GCS=False
GS_BUCKET_NAME=your-gcs-bucket-name
GS_PROJECT_ID=your-gcp-project-id
GS_CREDENTIALS_FILE=/path/to/service-account.json
GS_QUERYSTRING_AUTH=False
